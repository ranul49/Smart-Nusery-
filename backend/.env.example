# ------------------------------------------------------------------
# Smart Cassava Nursery — backend configuration (Project SEN-20-5112)
# Copy this file to `.env` and adjust as needed.
# ------------------------------------------------------------------

# HTTP server
PORT=4000
HOST=0.0.0.0

# JSON Web Token signing secret (CHANGE THIS in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Shared API key that ESP32 field nodes use to POST readings to /api/ingest
DEVICE_API_KEY=esp32-nursery-shared-key

# Built-in device simulator (Smart Farming Cycle). Set to "false" to disable
# and rely only on real ESP32 nodes posting to /api/ingest.
SIMULATOR_ENABLED=true
# Sensor sampling / transmit interval in seconds (Chapter 3: 5s cadence)
SAMPLE_INTERVAL_SEC=5

# ------------------------------------------------------------------
# Live data source: "simulator" | "thinger" | "ingest"
#   simulator -> self-generated data (default demo mode)
#   thinger   -> poll Thinger.io, which the ESP32 streams to (Chapter 3.5.3)
#   ingest    -> wait for the ESP32 to POST directly to /api/ingest
# ------------------------------------------------------------------
DATA_SOURCE=simulator

# Thinger.io connector (only used when DATA_SOURCE=thinger)
THINGER_HOST=https://api.thinger.io
THINGER_USER=
THINGER_TOKEN=
# Read EITHER a data bucket…
THINGER_BUCKET=
# …OR a device resource (leave BUCKET blank if using these):
THINGER_DEVICE=
THINGER_RESOURCE=
THINGER_POLL_SEC=5
# Field names inside your Thinger payload (change to match what the ESP32 sends)
THINGER_FIELD_HUMIDITY=humidity
THINGER_FIELD_TEMPERATURE=temperature
THINGER_FIELD_SOIL=soil
THINGER_FIELD_LIGHT=light

# ------------------------------------------------------------------
# Twilio SMS (last-mile farmer alerting). Optional — when these are
# blank the backend logs the SMS to the console instead of sending it,
# so the system runs end-to-end with no external account required.
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
